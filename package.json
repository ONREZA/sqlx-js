{
  "name": "@onreza/sqlx-js",
  "version": "0.21.0",
  "description": "Compile-time-checked raw SQL for TypeScript + PostgreSQL. Inspired by sqlx.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3",
    "deno": ">=2.9"
  },
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "sqlx-js": "dist/bin/sqlx-js.js",
    "sqlx-js-diagnostics": "dist/bin/sqlx-js-diagnostics.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "docs",
    "skills",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONREZA/sqlx-js.git"
  },
  "homepage": "https://github.com/ONREZA/sqlx-js#readme",
  "bugs": {
    "url": "https://github.com/ONREZA/sqlx-js/issues"
  },
  "keywords": [
    "bun",
    "node",
    "postgres",
    "postgresql",
    "sql",
    "sqlx",
    "typescript",
    "type-safe",
    "migrations"
  ],
  "scripts": {
    "prepare": "node scripts/prepare-package.mjs",
    "test": "bun test tests --timeout 120000",
    "test:docs": "node scripts/check-doc-links.mjs",
    "test:skills": "node scripts/validate-skills.mjs",
    "test:typecheck": "tsc --noEmit",
    "test:example": "bunx tsc -p example --noEmit",
    "test:runtime-boundary": "bun run build && node scripts/check-runtime-boundary.mjs",
    "test:node-package": "node scripts/node-package-smoke.mjs",
    "test:deno-package": "bun run build && deno run --allow-env=DATABASE_URL,SQLX_JS_FILE_ROOT --allow-net scripts/deno-package-smoke.mjs",
    "test:postgres-auth-tls": "bun run build && node scripts/postgres-auth-tls-smoke.mjs",
    "test:runtime-soak": "bun run build && node scripts/postgres-runtime-soak.mjs",
    "test:runtime-chaos": "bun run build && node scripts/postgres-runtime-chaos.mjs",
    "benchmark:postgres": "bun run build && node scripts/postgres-runtime-benchmark.mjs",
    "benchmark:postgres:profile": "bun run build && node scripts/profile-postgres-runtime.mjs",
    "test:corpus": "bun scripts/check-production-corpus.ts",
    "sqlx:prepare": "bun bin/sqlx-js.ts prepare",
    "sqlx:migrate": "bun bin/sqlx-js.ts migrate",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && bun scripts/fix-dist-imports.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "typescript": ">=5.4 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "libpg-query": "^17.7.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "postgres": "3.4.9",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "archiver": "8.0.0",
    "brace-expansion": "5.0.8",
    "protobufjs": "7.6.5"
  }
}
